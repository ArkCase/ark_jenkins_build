#!/bin/bash
SCRIPT="$(readlink -f "${BASH_SOURCE:-${0}}")"
BASEDIR="$(dirname "${SCRIPT}")"
SCRIPT="$(basename "${SCRIPT}")"

set -euo pipefail
. /.functions

usage()
{
	echo -e "usage: ${BASH_ARGV0} git-url"
	exit 1
}

[ ${#} -ne 1 ] && usage

# With no symref (i.e. a detached HEAD), there's no default branch to report
git ls-remote --exit-code --symref "${1}" HEAD | \
	awk -F'\t' 'NR == 1 && sub(/^ref: refs\/heads\//, "", $1) { print $1 ; FOUND = 1 } END { exit !FOUND }' || \
	{ err "Failed to identify the default branch" 1>&2 ; exit 1 ; }
